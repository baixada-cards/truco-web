# Development-only defaults. Next.js loads this when NODE_ENV=development.
# Committed on purpose: no secrets belong here. Real secrets live in 1Password
# and are loaded into the process environment at runtime.

# Writes per-action timing events to truco-frontend/debug-timing.log so we can
# diagnose perceived latency (e.g. first-round play delay) without opening
# DevTools. No-op in production.
NEXT_PUBLIC_DEBUG_TIMING=1
