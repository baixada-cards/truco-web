# Next.js BFF -> Rust engine service base URL.
TRUCO_ENGINE_SERVICE_URL=http://127.0.0.1:4000

# Optional audience for an IAM-protected Cloud Run `truco-server`. When set,
# the BFF obtains a short-lived Google identity token from the Cloud Run
# metadata server and sends it in X-Serverless-Authorization. Leave unset for
# local development and other directly reachable server deployments.
# TRUCO_ENGINE_SERVICE_AUDIENCE=https://truco-server-HASH.us-west1.run.app

# Sign the anonymous live-session cookie. Production requires a secret of at
# least 32 characters; generate one (for example, `openssl rand -base64 32`),
# store it in your secret manager, and uncomment the assignment only in an
# ignored local environment file. Never reuse a value from documentation.
# `TRUCO_LIVE_COOKIE_SECRET` remains a compatibility alias.
# TRUCO_ANON_COOKIE_SECRET=<generated-secret>

# Session lifecycle defaults are relaxed outside production. Copy these values
# into the environment for both the Next.js app and `truco-server` when
# you want explicit local behavior instead of the built-in defaults.
#
# Enable the routed live-page dev panel locally when you want quick reload/dealer
# controls and debug readouts. Production builds ignore this flag.
# NEXT_PUBLIC_SHOW_DEV_CONTROLS=true
#
# Dev-only mutation/private-view routes default on outside production and are
# always disabled when NODE_ENV=production.
# TRUCO_ENABLE_DEV_ROUTES=false
#
# Study route mode is read by the server at request time. `stealth` enables the
# direct URL without adding product links; `public` enables the route and can
# be paired with NEXT_PUBLIC_STUDY_LAB_LINKS=true in a production build.
# STUDY_LAB_MODE=stealth
# STUDY_MANIFEST_URL=https://storage.googleapis.com/truco-study-artifacts/releases/RELEASE_ID/manifest.json
# NEXT_PUBLIC_STUDY_LAB_LINKS=false
# NEXT_PUBLIC_STUDY_MANIFEST_URL=https://storage.googleapis.com/truco-study-artifacts/releases/RELEASE_ID/manifest.json
#
# `0` disables the limit.
TRUCO_SESSION_IDLE_TTL_SECONDS=0
TRUCO_SESSION_MAX_ACTIVE_PER_SUBJECT=0
TRUCO_SESSION_CREATE_RATE_LIMIT_WINDOW_SECONDS=60
TRUCO_SESSION_CREATE_RATE_LIMIT_MAX=0

# Production defaults when `NODE_ENV=production` and these vars are unset:
# - idle TTL: 1800 seconds (30 minutes)
# - max active matches per subject: 5
# - creation rate window: 300 seconds (5 minutes)
# - creation rate max: 10
